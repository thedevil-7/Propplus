# ==============================================================================
# PropPulse — Environment Variables Template
# Copy this file to .env for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-SIDE PRIVATE SECRETS (NODE.JS ONLY - NEVER EXPOSED TO CLIENT)
# ------------------------------------------------------------------------------
# Private API key for external state & city provider (if using authenticated API)
CITY_API_KEY=

# Server Port
PORT=3000

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Server-Side Provider Endpoints
CITY_API_URL=https://indian-cities-api-nocbegfhqg.now.sh/
CITY_API_BACKUP_URL=https://raw.githubusercontent.com/fayazara/Indian-Cities-API/master/db.json

# ------------------------------------------------------------------------------
# CLIENT-SIDE PUBLIC METADATA (VITE FRONTEND)
# ------------------------------------------------------------------------------
VITE_APP_TITLE=PropPulse — AI Real Estate Intelligence
VITE_APP_DESCRIPTION=See It. Analyze It. Predict Its Value.
VITE_CITY_API_URL=https://indian-cities-api-nocbegfhqg.now.sh/
VITE_CITY_API_BACKUP_URL=https://raw.githubusercontent.com/fayazara/Indian-Cities-API/master/db.json
VITE_ENABLE_MOCK_SERVICES=true
VITE_ENABLE_TELEMETRY=false
